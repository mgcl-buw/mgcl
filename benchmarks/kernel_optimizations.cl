    printf(" v[i+1][ j ][ k ] = %e\n", rp == NULL ? A[index + ioff] : rp[index]);
    printf(" v[ i ][j-1][k-1] = %e\n", A[index - joff - koff]);
    printf(" v[ i ][j-1][k+1] = %e\n", A[index - joff + koff]);
    printf(" v[ i ][j+1][k-1] = %e\n", A[index + joff - koff]);
    printf(" v[ i ][j+1][k+1] = %e\n", A[index + joff + koff]);
    printf(" v[i-1][ j ][k-1] = %e\n", rm == NULL ? A[index - ioff - 1] : rm[index - 1]);
